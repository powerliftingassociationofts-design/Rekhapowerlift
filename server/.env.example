# Environment Variables for Email Server
# Copy this file to .env and fill in your actual credentials

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server Configuration
PORT=5000

# Instructions:
# 1. For Gmail, you need to enable 2-factor authentication
# 2. Generate an "App Password" in your Google Account settings
# 3. Use the app password as EMAIL_PASS, not your regular password
# 4. Replace EMAIL_USER with your actual Gmail address
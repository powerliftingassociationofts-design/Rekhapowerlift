# Environment Variables for Rekhapowerlift Server
# Copy this file to .env and fill in your actual credentials

# Server Configuration
PORT=5000

# AWS S3 Configuration
# Required for file uploads (images, PDFs, documents)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=rekhapowerlift-bucket

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional: Application URL
APP_URL=http://localhost:3000

# Instructions:
# 
# AWS S3 Setup:
# 1. Create an AWS account at https://aws.amazon.com/
# 2. Create an S3 bucket in your preferred region
# 3. Create an IAM user with S3 permissions (AmazonS3FullAccess)
# 4. Generate access keys for the IAM user
# 5. Update AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and AWS_S3_BUCKET_NAME
# 
# Email Setup (Gmail):
# 1. Enable 2-factor authentication on your Google Account
# 2. Generate an "App Password" in your Google Account settings
# 3. Use the app password as EMAIL_PASS, not your regular password
# 4. Replace EMAIL_USER with your actual Gmail address